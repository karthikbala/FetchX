{
  "name": "fetchx-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4327",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4327",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "types": "wrangler types --env-interface CloudflareEnv --include-runtime false",
    "pages:dev": "wrangler pages dev dist --port 4328",
    "pages:deploy": "wrangler pages deploy dist --project-name fetchx-marketing",
    "test:browser": "node tests/ui/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  }
}
