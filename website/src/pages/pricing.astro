---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Closing from '../components/Closing.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/marketing/Faq.astro';
import '../styles/marketing.css';
const faqs = [
  ['How do I buy credits?', 'Choose a pack and sign in. Your project’s Billing page shows checkout availability and your balances. When a paid route is ready for your project, continue to Stripe to confirm a one-time purchase.'],
  ['Do paid credits expire?', 'Paid credits have no scheduled expiration. Each top-up is a one-time payment, with no automatic renewal.'],
  ['How does trial access work?', 'Eligible accounts receive a single grant of 1,000 trial credits for approved direct or datacenter native HTTP routes. Trial limits apply while the project has trial access. On projects eligible for a combined balance, unused signup credits join the purchased credits after the first confirmed purchase. Your workspace shows available routes and current limits.'],
  ['What happens when a transfer reaches its limit?', 'The gateway stops the transfer at its configured limit. Choose a larger cap before submitting a new request if the route supports it. Preserve the operation key and recover the saved result when the outcome is uncertain.'],
  ['What if I need browser rendering or a specific country?', 'Your project advertises its available routes and countries. Browser workflows require separate qualification.'],
];
---
<Layout title="Pricing — FetchX" description="Start with 1,000 trial credits on an eligible account or choose one-time FetchX credit packs starting at $2. Check route availability in your workspace." active="pricing">
  <div class="mkt"><div class="mkt-container">
    <header class="mkt-page-intro mkt-centered"><span class="mkt-eyebrow">PREPAID FETCHX CREDITS</span><h1>Buy credits once.<br/><span class="mkt-muted">Use them as you go.</span></h1><p>Choose a pack from 10,000 to 1,000,000 credits. Your project shows available paid routes and checkout status.</p></header>
    <div id="compare"><Pricing/></div>
    <section class="mkt-credit-section" id="credits"><div><span class="mkt-eyebrow">01 / HOW USAGE WORKS</span><h2>Public URL HTTP charges by transfer.</h2><p>A public URL request reserves credits for its transfer limit. The final charge follows measured wire traffic across all hops, rounded up to the route’s billing unit. An uncertain outcome keeps its reservation held until reconciled.</p></div><div class="mkt-credit-factors"><article><Icon name="route" size={22}/><div><h3>Datacenter · 1 credit</h3><p>1 credit per started 1 MB. The default transfer limit is 1 MB.</p></div></article><article><Icon name="globe" size={22}/><div><h3>Residential · 5 credits</h3><p>5 credits per started 250 KB. The default transfer limit is 250 KB.</p></div></article><article><Icon name="code" size={22}/><div><h3>Larger transfers are opt-in</h3><p>Where supported, set a transfer limit up to 20 MB and an optional credit cap. Sizes use decimal units.</p></div></article></div></section>
    <section class="mkt-section mkt-faq-section"><div><span class="mkt-eyebrow">02 / BILLING AND ACCESS</span><h2>Before your<br/><span class="mkt-muted">first request.</span></h2><a class="mkt-text-link" href="/contact">Discuss your workload <Icon name="arrow" size={16}/></a></div><Faq items={faqs}/></section>
  </div><Closing/></div>
</Layout>
