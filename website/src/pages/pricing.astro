---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Closing from '../components/Closing.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/marketing/Faq.astro';
import '../styles/marketing.css';
const faqs = [
  ['How do I buy credits?', 'Choose a pack and sign in. Your project’s Credits & usage page shows your balance; continue to Stripe to confirm a one-time purchase, by card in USD or UPI in INR.'],
  ['Do paid credits expire?', 'Paid credits have no scheduled expiration. Each top-up is a one-time payment, with no automatic renewal.'],
  ['How does the trial work?', 'Each account gets 1,000 trial credits once, on its first project. Trial and purchased credits share one balance, and every route is available.'],
  ['Am I charged for failed requests?', 'No. A request is charged only when it succeeds, at the price of the step that got the data: 1 credit over HTTP, 5 over a residential IP, 10 in a browser, 25 in a browser over a residential IP, plus 10 when a captcha was solved. Set max_credits to cap any request.'],
  ['What if I need browser rendering or a specific country?', 'Both are included. Auto mode uses a browser when the page needs one, and country sets the exit country.'],
];
---
<Layout title="Pricing — FetchX" description="Start with 1,000 trial credits, then buy one-time FetchX credit packs in your local currency. Only successful requests are charged." active="pricing">
  <div class="mkt"><div class="mkt-container">
    <header class="mkt-page-intro mkt-centered"><span class="mkt-eyebrow">PREPAID FETCHX CREDITS</span><h1>Buy credits once.<br/><span class="mkt-muted">Use them as you go.</span></h1><p>Choose a pack from 10,000 to 1,000,000 credits. Your project shows available paid routes and checkout status.</p></header>
    <div id="compare"><Pricing/></div>
    <section class="mkt-credit-section" id="credits"><div><span class="mkt-eyebrow">01 / HOW USAGE WORKS</span><h2>You pay for the step that worked.</h2><p>Each request climbs from the cheapest route until the site gives its real answer. Only that step is charged; blocks, timeouts and every earlier failed attempt are free. Set max_credits to cap any request.</p></div><div class="mkt-credit-factors"><article><Icon name="route" size={22}/><div><h3>HTTP · 1 credit</h3><p>Direct or through a datacenter proxy.</p></div></article><article><Icon name="globe" size={22}/><div><h3>Residential HTTP · 5 credits</h3><p>Plus 5 credits per MB beyond the first MB.</p></div></article><article><Icon name="code" size={22}/><div><h3>Browser · 10 or 25 credits</h3><p>25 over a residential IP (5 MB included). A solved captcha adds 10.</p></div></article></div></section>
    <section class="mkt-section mkt-faq-section"><div><span class="mkt-eyebrow">02 / BILLING AND ACCESS</span><h2>Before your<br/><span class="mkt-muted">first request.</span></h2><a class="mkt-text-link" href="/contact">Discuss your workload <Icon name="arrow" size={16}/></a></div><Faq items={faqs}/></section>
  </div><Closing/></div>
</Layout>
