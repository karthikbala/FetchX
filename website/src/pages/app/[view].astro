---
import AppShell from '../../components/app/AppShell.astro';
import AppContent from '../../components/app/AppContent.astro';
import { previewViews } from '../../data/product-preview';
export function getStaticPaths() { return previewViews.map(view => ({ params: { view }, props: { view } })); }
const { view } = Astro.props;
---
<AppShell view={view}><AppContent view={view}/></AppShell>
