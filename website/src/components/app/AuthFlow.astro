---
import Layout from '../../layouts/Layout.astro';
import Brand from '../Brand.astro';
import Icon from '../Icon.astro';
import '../../styles/product-preview.css';
const { login = false } = Astro.props as { login?: boolean };
---
<Layout title={`${login ? 'Log in' : 'Create a workspace'} — FetchX`} description="Verify your email and open your FetchX developer workspace." appMode={true} noindex={true}>
  <div class="product-preview pp-auth" data-product-preview data-view={login ? 'login' : 'signup'}>
    <div class="pp-preview-bar"><span><span class="pp-live-dot"></span> FetchX workspace <span class="pp-preview-detail" data-service-status>Checking service availability…</span></span><a href="/docs">API docs ↗</a></div>
    <header class="pp-auth-header"><a href="/" class="pp-brand" aria-label="FetchX home"><Brand/></a><a href={login ? '/signup' : '/login'} class="pp-auth-switch">{login ? 'New around here?' : 'Already have an account?'} <strong>{login ? 'Start building' : 'Log in'} <Icon name="arrow" size={15}/></strong></a></header>
    <div class="pp-auth-layout"><aside class="pp-auth-story"><p class="pp-eyebrow">THE WEB IS YOUR INPUT.</p><h1>Your next idea.<br/>A request away<span>.</span></h1><p>Start with your email. Choose a project. Fetch through the access profiles approved for your workspace.</p><div class="pp-auth-terminal" aria-label="Request workflow"><div><span class="pp-terminal-dots"><i></i><i></i><i></i></span><span>your-workspace</span><span>HTTP</span></div><pre><span class="pp-code-cyan">request</span> <span class="pp-code-lime">→</span> source
source  <span class="pp-code-lime">→</span> response
response <span class="pp-code-lime">→</span> <span class="pp-code-cyan">your next idea</span></pre><div class="pp-terminal-status">Your application stays in control.</div></div><div class="pp-auth-benefits"><span><Icon name="check" size={16}/> Email verification, no password</span><span><Icon name="check" size={16}/> Scoped project credentials</span><span><Icon name="check" size={16}/> Retained outcomes and usage</span></div></aside>
    <section class="pp-auth-form-card" aria-label={login ? 'Log in' : 'Create an account'}>
      <p class="pp-inline-error pp-live-error" data-page-error role="alert" hidden></p>
      <div class="pp-auth-progress" data-auth-progress aria-label="Account setup steps"><span data-signup-progress="0" class="is-current">1</span><i></i><span data-signup-progress="1">2</span><i></i><span data-signup-progress="2">3</span><i></i><span data-signup-progress="3">4</span></div>
      <div data-signup-stage="0"><span class="pp-eyebrow">01 / YOUR EMAIL</span><h2>{login ? 'Back to building.' : 'Build something worth fetching.'}</h2><p data-auth-delivery-help>We’ll email a one-time code to verify your address.</p><form data-signup-email><label class="pp-field">Email address<input type="email" name="email" placeholder="you@company.com" autocomplete="email" maxlength="254" required/><small>Use an address you can access.</small></label><button type="submit" class="pp-button pp-button-primary pp-full" disabled>Send verification code <Icon name="arrow" size={17}/></button></form><p class="pp-auth-privacy">Account access uses a secure session cookie. Commercial access requires approval.</p></div>
      <div data-signup-stage="1" hidden><span class="pp-eyebrow">02 / VERIFY EMAIL</span><h2>Check your inbox.</h2><p data-verification-help>Enter the eight-digit code from your email.</p><form data-signup-verify><label class="pp-field">Verification code<input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{8}" required aria-describedby="verification-help"/><small id="verification-help">Codes expire. Request a new code if yours is no longer valid.</small></label><button type="submit" class="pp-button pp-button-primary pp-full">Verify email <Icon name="arrow" size={17}/></button></form><button type="button" class="pp-text-link pp-resend-code" data-resend-code>Send a new code</button><button type="button" class="pp-text-link pp-auth-skip" data-change-email>Use another email</button></div>
      <div data-signup-stage="2" hidden><span class="pp-eyebrow">03 / CREATE A PROJECT</span><h2>A home for your requests.</h2><p>Your email is verified. Create a project to receive its configured access and credit allocation.</p><form data-signup-project><label class="pp-field">Project name<input type="text" name="project" placeholder="My first project" maxlength="80" autocomplete="off" required/></label><button type="submit" class="pp-button pp-button-primary pp-full">Create project <Icon name="arrow" size={17}/></button></form><a href="/app" class="pp-text-link pp-auth-skip">Open workspace</a></div>
      <div data-signup-stage="3" hidden><span class="pp-eyebrow">04 / YOUR FIRST KEY</span><h2>Connect your application.</h2><p>Create a key for <strong data-project-name>your project</strong>. Its secret is shown once.</p><form data-signup-key><label class="pp-field">Key name<input name="name" value="My first key" maxlength="80" required autocomplete="off"/></label><fieldset class="pp-scopes"><legend>Key permissions</legend>{['fetch:read','fetch:write','usage:read','profiles:read'].map(scope=><label><input type="checkbox" name="scope" value={scope} checked/>{scope}</label>)}</fieldset><button type="submit" class="pp-button pp-button-primary pp-full">Create API key</button></form><div class="pp-signup-key" data-signup-reveal hidden><span class="pp-soft-tag">SAVE THIS SECRET NOW</span><code data-signup-secret>Concealed</code><button type="button" class="pp-button pp-button-secondary" data-signup-copy><Icon name="copy" size={15}/> Copy key</button><button type="button" class="pp-button pp-button-quiet" data-conceal-signup-key>Conceal key</button><p class="pp-form-help">Keep it on your server. Refreshing or leaving this page conceals it.</p></div><a href="/app/playground" class="pp-button pp-button-primary pp-full pp-auth-skip" data-finish-signup hidden>Make your first request <Icon name="arrow" size={17}/></a><a href="/app/keys" class="pp-text-link pp-auth-skip">Manage keys in your workspace</a></div>
      <div data-auth-existing hidden><span class="pp-soft-tag">SIGNED IN</span><h2>Welcome back.</h2><p>Your verified session is ready.</p><a href="/app" class="pp-button pp-button-primary pp-full">Open workspace <Icon name="arrow" size={17}/></a><button type="button" class="pp-text-link pp-auth-skip" data-logout>Sign out</button></div>
      <noscript><p>Enable JavaScript to verify your email and use the workspace.</p></noscript>
    </section></div>
    <footer class="pp-auth-footer"><span>FetchX by Headrun</span><a href="/">Back to website <Icon name="arrow" size={14}/></a><a href="/privacy">Privacy</a></footer>
    <div class="pp-toast" role="status" aria-live="polite" data-toast hidden></div>
  </div>
  <script>import '../../scripts/product-preview';</script>
</Layout>
