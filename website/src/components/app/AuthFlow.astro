---
import Layout from '../../layouts/Layout.astro';
import Brand from '../Brand.astro';
import Icon from '../Icon.astro';
import '../../styles/product-preview.css';
const { login = false } = Astro.props as { login?: boolean };
---
<Layout title={`${login ? 'Log in' : 'Create a workspace'} — FetchX`} description="Sign in with GitHub, Google or verify your email to open your FetchX developer workspace." appMode={true} noindex={true}>
  <div class="product-preview pp-auth" data-product-preview data-view={login ? 'login' : 'signup'}>
    <div class="pp-preview-bar"><span><span class="pp-live-dot"></span> FetchX workspace <span class="pp-preview-detail" data-service-status>Checking service availability…</span></span><a href="/docs">API docs ↗</a></div>
    <header class="pp-auth-header"><a href="/" class="pp-brand" aria-label="FetchX home"><Brand/></a><a href={login ? '/signup' : '/login'} class="pp-auth-switch">{login ? 'New around here?' : 'Already have an account?'} <strong>{login ? 'Start building' : 'Log in'} <Icon name="arrow" size={15}/></strong></a></header>
    <div class="pp-auth-layout"><aside class="pp-auth-story"><p class="pp-eyebrow">THE WEB IS YOUR INPUT.</p><h1>Your next idea.<br/>A request away<span>.</span></h1><p>Sign in with GitHub, Google or your email. Choose a project. Fetch through the access profiles approved for your workspace.</p><div class="pp-auth-terminal" aria-label="Request workflow"><div><span class="pp-terminal-dots"><i></i><i></i><i></i></span><span>your-workspace</span><span>HTTP</span></div><pre><span class="pp-code-cyan">request</span> <span class="pp-code-lime">→</span> source
source  <span class="pp-code-lime">→</span> response
response <span class="pp-code-lime">→</span> <span class="pp-code-cyan">your next idea</span></pre><div class="pp-terminal-status">Your application stays in control.</div></div><div class="pp-auth-benefits"><span><Icon name="check" size={16}/> Secure sign-in, no password</span><span><Icon name="check" size={16}/> Scoped project credentials</span><span><Icon name="check" size={16}/> Retained outcomes and usage</span></div></aside>
    <section class="pp-auth-form-card" aria-label={login ? 'Log in' : 'Create an account'}>
      <p class="pp-inline-error pp-live-error" data-page-error role="alert" hidden></p>
      <div class="pp-auth-progress" data-auth-progress aria-label="Account setup steps"><span data-signup-progress="0" class="is-current">1</span><i></i><span data-signup-progress="1">2</span><i></i><span data-signup-progress="2">3</span><i></i><span data-signup-progress="3">4</span></div>
      <div data-signup-stage="0"><span class="pp-eyebrow">01 / GET STARTED</span><h2>{login ? 'Back to building.' : 'Build something worth fetching.'}</h2><div class="pp-github-signin" data-github-signin hidden><button type="button" class="pp-button pp-button-secondary pp-full pp-github-button" data-github-start><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.769-.244.769-.543 0-.267-.01-.974-.015-1.912-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.023-.7.078-.686.078-.686 1.131.08 1.727 1.16 1.727 1.16 1.006 1.724 2.64 1.226 3.282.938.103-.73.394-1.227.716-1.51-2.498-.284-5.124-1.25-5.124-5.563 0-1.229.439-2.233 1.16-3.02-.117-.285-.503-1.43.11-2.98 0 0 .945-.303 3.094 1.154a10.8 10.8 0 0 1 5.632 0c2.148-1.457 3.091-1.154 3.091-1.154.615 1.55.23 2.695.113 2.98.723.787 1.158 1.791 1.158 3.02 0 4.324-2.63 5.276-5.136 5.555.404.35.765 1.04.765 2.095 0 1.513-.014 2.733-.014 3.104 0 .302.203.652.774.542A11.25 11.25 0 0 0 12 .75Z"/></svg><span data-github-label>Continue with GitHub</span></button><p class="pp-auth-provider-help">Uses your verified email. No repository access.</p><p class="pp-google-status" data-github-status role="status" aria-live="polite"></p><p class="pp-inline-error" data-github-error role="alert" hidden></p></div><div class="pp-google-signin" data-google-signin role="group" aria-label="Google sign-in" hidden><p class="pp-google-status" data-google-status role="status" aria-live="polite"></p><div class="pp-google-button" data-google-button></div><p class="pp-inline-error pp-google-error" data-google-error role="alert" hidden></p><button type="button" class="pp-text-link pp-google-reload" data-google-reload hidden>Reload Google sign-in</button></div><div class="pp-auth-divider" data-auth-divider hidden><span>or use an email code</span></div><p data-auth-delivery-help>We’ll email a one-time code to verify your address.</p><form data-signup-email><label class="pp-field">Email address<input type="email" name="email" placeholder="you@company.com" autocomplete="email" maxlength="254" required/><small>Use an address you can access.</small></label><button type="submit" class="pp-button pp-button-primary pp-full" disabled>Send verification code <Icon name="arrow" size={17}/></button></form><p class="pp-auth-privacy">Account access uses a secure session cookie. Commercial access requires approval.</p></div>
      <div data-signup-stage="1" hidden><span class="pp-eyebrow">02 / VERIFY EMAIL</span><h2>Check your inbox.</h2><p data-verification-help>Enter the eight-digit code from your email.</p><form data-signup-verify><label class="pp-field">Verification code<input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{8}" required aria-describedby="verification-help"/><small id="verification-help">Codes expire. Request a new code if yours is no longer valid.</small></label><button type="submit" class="pp-button pp-button-primary pp-full">Verify email <Icon name="arrow" size={17}/></button></form><button type="button" class="pp-text-link pp-resend-code" data-resend-code>Send a new code</button><button type="button" class="pp-text-link pp-auth-skip" data-change-email>Use another email</button></div>
      <div data-signup-stage="2" hidden><span class="pp-eyebrow">03 / CREATE A PROJECT</span><h2>A home for your requests.</h2><p>Your email is verified. Create a project to receive its configured access and credit allocation.</p><form data-signup-project><label class="pp-field">Project name<input type="text" name="project" placeholder="My first project" maxlength="80" autocomplete="off" required/></label><button type="submit" class="pp-button pp-button-primary pp-full">Create project <Icon name="arrow" size={17}/></button></form><a href="/app" class="pp-text-link pp-auth-skip">Open workspace</a></div>
      <div data-signup-stage="3" hidden><span class="pp-eyebrow">04 / YOUR FIRST KEY</span><h2>Connect your application.</h2><p>Create a key for <strong data-project-name>your project</strong>. Its secret is shown once.</p><form data-signup-key><label class="pp-field">Key name<input name="name" data-key-name placeholder="My first key" maxlength="80" required autocomplete="off"/></label><fieldset class="pp-scopes"><legend>Key permissions</legend>{['fetch:read','fetch:write','usage:read','profiles:read'].map(scope=><label><input type="checkbox" name="scope" value={scope} checked/>{scope}</label>)}</fieldset><button type="submit" class="pp-button pp-button-primary pp-full">Create API key</button></form><div class="pp-signup-key" data-signup-reveal hidden><span class="pp-soft-tag">SAVE THIS SECRET NOW</span><code data-signup-secret>Concealed</code><button type="button" class="pp-button pp-button-secondary" data-signup-copy><Icon name="copy" size={15}/> Copy key</button><button type="button" class="pp-button pp-button-quiet" data-conceal-signup-key>Conceal key</button><p class="pp-form-help">Keep it on your server. Refreshing or leaving this page conceals it.</p></div><a href="/app/playground" class="pp-button pp-button-primary pp-full pp-auth-skip" data-finish-signup hidden>Make your first request <Icon name="arrow" size={17}/></a><a href="/app/keys" class="pp-text-link pp-auth-skip">Manage keys in your workspace</a></div>
      <div data-auth-existing hidden><span class="pp-soft-tag">SIGNED IN</span><h2>Welcome back.</h2><p>Your verified session is ready.</p><a href="/app" class="pp-button pp-button-primary pp-full">Open workspace <Icon name="arrow" size={17}/></a></div>
      <div class="pp-auth-account" data-auth-account hidden><p>Signed in as <strong class="pp-auth-email" data-user-email></strong>.</p><div data-github-account hidden><p class="pp-google-status" data-github-connected role="status" hidden>GitHub is connected.</p><button type="button" class="pp-button pp-button-secondary pp-full" data-github-connect>Connect GitHub</button><p class="pp-google-status" data-github-link-status role="status" aria-live="polite"></p><p class="pp-inline-error" data-github-link-error role="alert" hidden></p></div><button type="button" class="pp-button pp-button-secondary pp-full pp-auth-skip" data-logout>Sign out</button></div>
      <noscript><p>Enable JavaScript to sign in and use the workspace.</p></noscript>
    </section></div>
    <footer class="pp-auth-footer"><span>FetchX</span><a href="/">Back to website <Icon name="arrow" size={14}/></a><a href="/privacy">Privacy</a></footer>
    <div class="pp-toast" role="status" aria-live="polite" data-toast hidden></div>
  </div>
  <script>import '../../scripts/product-preview';</script>
</Layout>
