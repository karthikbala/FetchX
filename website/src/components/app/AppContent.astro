---
import Icon from '../Icon.astro';
import { type PreviewView } from '../../data/product-preview';
const { view } = Astro.props as { view: PreviewView };
---
{(view === 'overview' || view === 'billing') && <>
  <div class="pp-metrics"><article class="pp-card pp-metric"><span>Available credits</span><strong data-credits-available>—</strong><small data-credits-granted>Project allocation</small></article><article class="pp-card pp-metric"><span>Credits used</span><strong data-credits-used>—</strong><small>Settled logical HTTP operations</small></article><article class="pp-card pp-metric"><span>Reserved + held</span><strong data-reserved-credits>—</strong><small>Unknown work retains its reservation</small></article><article class="pp-card pp-metric"><span>Total requests</span><strong data-request-count>—</strong><small>Project lifetime · gateway operations</small></article></div>
  <div class="pp-two-panels pp-live-panels"><section class="pp-card pp-info-card"><h2>Recorded outcomes</h2><dl class="pp-live-facts"><div><dt>Source successes</dt><dd data-source-successes>—</dd></div><div><dt>Source failures</dt><dd data-source-failures>—</dd></div><div><dt>Gateway failures</dt><dd data-gateway-failures>—</dd></div><div><dt>Unknown outcomes</dt><dd data-unknown-outcomes>—</dd></div><div><dt>Mean latency</dt><dd data-mean-latency>—</dd></div><div><dt>95th percentile</dt><dd data-p95-latency>—</dd></div></dl><p class="pp-form-help">A source response still needs validation in your application. Provider invoices are accounted for separately.</p></section><section class="pp-card pp-info-card"><span class="pp-eyebrow">PROJECT ACCESS</span><h2 data-billing-status>Checking status…</h2><p data-billing-description>Fetching the current allocation and approval status.</p><dl class="pp-live-facts"><div><dt>Reserved credits</dt><dd data-credits-reserved>—</dd></div><div><dt>Held credits</dt><dd data-credits-held>—</dd></div><div><dt>Released credits</dt><dd data-credits-released>—</dd></div></dl><p class="pp-form-help">Commercial activation and additional credits require operator approval. There is no automatic refill or overage.</p><a href="/contact" class="pp-text-link">Discuss access <Icon name="arrow" size={15}/></a></section></div>
</>}
{view === 'overview' && <section class="pp-card"><div class="pp-card-heading"><div><h2>Recent requests</h2><p>Retained project operations.</p></div><a href="/app/requests" class="pp-text-link">View all <Icon name="arrow" size={16}/></a></div><div data-request-list data-request-limit="5"></div></section>}
{view === 'playground' && <>
  <div class="pp-callout"><Icon name="code" size={22}/><div><strong>Native HTTP</strong><p>Destinations, routes, and countries come from your project’s approved profiles.</p></div><span class="pp-soft-tag">Browser requires separate qualification</span></div>
  <div class="pp-playground-grid"><section class="pp-card pp-request-panel"><div class="pp-card-heading"><h2>Configure request</h2><span class="pp-mono">01 / INPUT</span></div><form data-playground-form>
    <label class="pp-field">Access profile<select data-request-profile required><option value="">Loading approved profiles…</option></select><small data-profile-summary>Profiles are issued by the service.</small></label>
    <label class="pp-field">Destination URL<input type="url" name="url" data-request-url placeholder="https://approved-source.example/path" required spellcheck="false" autocomplete="off"/><small>Use a destination approved by the selected profile.</small></label>
    <fieldset class="pp-mode-field"><legend>Execution</legend><div class="pp-mode-options"><label><input type="radio" name="mode" value="http" checked/><span><Icon name="code" size={19}/><strong>HTTP</strong><small>Native response</small></span></label><label><input type="radio" name="mode" value="browser" disabled/><span><Icon name="globe" size={19}/><strong>Browser</strong><small>Separate qualification</small></span></label></div></fieldset>
    <div class="pp-two-fields"><label class="pp-field">Proxy route<select name="route" data-request-route required></select></label><label class="pp-field">Country<select name="country" data-request-country></select></label></div>
    <label class="pp-field">Method<select data-request-method><option>GET</option><option>HEAD</option></select></label>
    <div class="pp-profile-summary"><span>Operation key</span><code data-operation-key>Assigned before dispatch</code><small>Retained for recovery. Source URLs and response bodies stay out of browser storage.</small></div>
    <p class="pp-inline-error" data-fetch-error role="alert" hidden></p><button type="submit" class="pp-button pp-button-primary pp-full" data-run-request disabled>Send request <Icon name="arrow" size={17}/></button><p class="pp-form-help">This contacts the configured source and uses project credits. Inspect source content before accepting it.</p>
  </form><div class="pp-live-request-actions"><button type="button" class="pp-button pp-button-secondary" data-new-request>Start a new request</button><button type="button" class="pp-button pp-button-secondary" data-recover-result hidden>Recover saved result</button><label class="pp-field" data-pending-label hidden>Pending operation<select data-pending-operation></select></label><p class="pp-form-help" data-recovery-note hidden>Recovery only reads retained state. Unknown reservations remain held.</p></div></section>
  <section class="pp-card pp-response-panel"><div class="pp-response-toolbar"><div class="pp-tabs" role="tablist" aria-label="Response inspector"><button type="button" role="tab" id="tab-output" aria-selected="true" aria-controls="panel-output" data-inspector-tab="output">Response</button><button type="button" role="tab" id="tab-diagnostics" aria-selected="false" aria-controls="panel-diagnostics" tabindex="-1" data-inspector-tab="diagnostics">Diagnostics</button><button type="button" role="tab" id="tab-code" aria-selected="false" aria-controls="panel-code" tabindex="-1" data-inspector-tab="code">Code</button></div><span class="pp-status" data-response-state>Ready</span></div>
    <div class="pp-response-body" id="panel-output" role="tabpanel" aria-labelledby="tab-output" data-inspector-panel="output"><p class="pp-form-help" data-response-note>No request has been sent.</p><pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Response text" data-response-output>Send a request to inspect the retained response.</pre><p class="pp-form-help">Response text is bounded and displayed as text. HTML is never executed. Application acceptance is evaluated by your application.</p></div>
    <div class="pp-response-body" id="panel-diagnostics" role="tabpanel" aria-labelledby="tab-diagnostics" data-inspector-panel="diagnostics" hidden><pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Response diagnostics" data-response-diagnostics>No diagnostics yet.</pre></div>
    <div class="pp-response-body" id="panel-code" role="tabpanel" aria-labelledby="tab-code" data-inspector-panel="code" hidden><div class="pp-code-toolbar"><label>Language<select data-code-language><option value="curl">cURL</option><option value="javascript">JavaScript</option><option value="python">Python</option></select></label><button type="button" class="pp-copy-button" data-copy-code>Copy code</button></div><pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Generated request code" data-generated-code>Choose an approved profile to generate code.</pre><p class="pp-form-help">Replace FETCHX_API_KEY on your server. Each deliberate request needs a new operation key; recover an uncertain operation with GET.</p></div>
  </section></div>
</>}
{view === 'requests' && <section class="pp-card"><div class="pp-card-heading"><div><h2>Request history</h2><p>Bounded retained history. Source captures appear only when you open a request.</p></div><button type="button" class="pp-button pp-button-secondary" data-refresh-history>Refresh history</button></div><div class="pp-filter-row"><label class="pp-field pp-live-search">Search operation ID<input type="search" data-request-search placeholder="Filter retained operations"/></label><label class="pp-field">State<select data-request-filter><option value="all">All states</option><option value="completed">Completed</option><option value="failed">Failed</option><option value="unknown">Unknown</option><option value="running">Running</option><option value="reserved">Reserved</option></select></label><span class="pp-soft-tag" data-filter-count>Loading…</span></div><div data-request-list></div></section>}
{view === 'keys' && <>
  <div class="pp-callout"><Icon name="lock" size={22}/><div><strong>Project credentials, with explicit permissions.</strong><p>Secrets are revealed once. Rotation revokes the old key. Never expose a key in browser code.</p></div></div>
  <section class="pp-card pp-live-key-create"><div class="pp-card-heading"><h2>Create an API key</h2></div><form data-create-key><label class="pp-field">Key name<input name="name" data-key-name maxlength="80" placeholder="Production server" required autocomplete="off"/></label><fieldset class="pp-scopes"><legend>Key permissions</legend>{['fetch:read','fetch:write','usage:read','profiles:read'].map(scope=><label><input type="checkbox" name="scope" value={scope} checked/>{scope}</label>)}</fieldset><button type="submit" class="pp-button pp-button-primary" data-generate-key>Create API key</button></form></section>
  <section class="pp-card"><div class="pp-card-heading"><div><h2>Project keys</h2><p>Safe metadata only. Existing secrets cannot be retrieved.</p></div></div><div data-key-list></div></section>
</>}
{view === 'onboarding' && <div class="pp-onboarding-layout"><section class="pp-card pp-checklist"><div class="pp-card-heading"><h2>Your first integration</h2><span class="pp-soft-tag" data-onboarding-count>Checking…</span></div><ol><li data-checklist-email><span class="pp-step-check">1</span><div><h3>Verify your email</h3><p>Your current session belongs to a verified account.</p></div></li><li data-checklist-project><span class="pp-step-check">2</span><div><h3>Create a project</h3><p>Each project has its own approved access and credits.</p><button type="button" class="pp-text-link" data-open-project>Create another project →</button></div></li><li data-checklist-key><span class="pp-step-check">3</span><div><h3>Create a scoped API key</h3><p>Keep the secret in your server environment.</p><a href="/app/keys" class="pp-text-link">Manage API keys →</a></div></li><li data-checklist-request><span class="pp-step-check">4</span><div><h3>Send your first request</h3><p>Inspect a retained response and validate the source data.</p><a href="/app/playground" class="pp-text-link">Open playground →</a></div></li></ol></section><aside class="pp-card pp-onboarding-aside"><span class="pp-eyebrow">KEEP THE OPERATION KEY</span><h2>A clear path through uncertainty.</h2><p>If a request times out, recover the saved operation using its original key. A new request is a deliberate action and may use additional credits.</p><a href="/docs" class="pp-text-link">Read the integration guide <Icon name="arrow" size={15}/></a></aside></div>}
