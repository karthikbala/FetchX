---
import Icon from '../Icon.astro';
import { FORMATS, KEY_SCOPES, type ConsoleView } from '../../data/console';
const { view } = Astro.props as { view: ConsoleView };
---
{(view === 'overview' || view === 'billing') && <>
  <section class="pp-card pp-credit-summary" data-credit-summary aria-labelledby="credit-summary-title">
    <h2 id="credit-summary-title">Available credits</h2>
    <p class="pp-credit-total" data-credit-total>Loading…</p>
    <dl class="pp-credit-breakdown" data-credit-breakdown hidden>
      <div><dt>Trial</dt><dd data-credit-trial>—</dd></div>
      <div><dt>Purchased</dt><dd data-credit-purchased>—</dd></div>
      <div><dt>Reserved by running requests</dt><dd data-credit-reserved>—</dd></div>
    </dl>
    <p class="pp-inline-error" data-credit-hold role="alert" hidden>Spending is paused while a payment is reviewed. Contact FetchX if this does not clear.</p>
  </section>
  <div class="pp-metrics">
    <article class="pp-card pp-metric"><span>Credits used</span><strong data-usage-credits>—</strong><small>This month</small></article>
    <article class="pp-card pp-metric"><span>Successful requests</span><strong data-usage-succeeded>—</strong><small>Charged at the step that worked</small></article>
    <article class="pp-card pp-metric"><span>Failed requests</span><strong data-usage-failed>—</strong><small>Never charged</small></article>
    <article class="pp-card pp-metric"><span>Captchas solved</span><strong data-usage-captcha>—</strong><small>This month</small></article>
  </div>
</>}
{view === 'billing' && <>
  <section class="pp-card pp-info-card" aria-labelledby="usage-steps-title">
    <h2 id="usage-steps-title">Where credits went</h2>
    <p class="pp-form-help">Each successful request costs the price of the step that got the data. Earlier failed steps cost nothing.</p>
    <div data-usage-steps></div>
    <h3>Prices</h3>
    <dl class="pp-live-facts" data-price-list></dl>
  </section>
  <section class="pp-card pp-info-card pp-stripe-billing" data-stripe-billing aria-labelledby="stripe-billing-heading" hidden>
    <div class="pp-stripe-heading"><h2 id="stripe-billing-heading">Buy credits</h2><span class="pp-soft-tag" data-stripe-mode></span></div>
    <p data-stripe-mode-help></p>
    <div class="pp-stripe-notice"><p data-stripe-status role="status"></p><div class="pp-stripe-actions"><button type="button" class="pp-button pp-button-secondary" data-stripe-check hidden>Check checkout status</button><button type="button" class="pp-button pp-button-primary" data-stripe-resume hidden>Resume saved checkout <Icon name="arrow" size={15}/></button></div></div>
    <p class="pp-inline-error" data-stripe-error role="alert" hidden></p>
    <div class="pp-stripe-plans" data-stripe-plans></div>
    <div class="pp-stripe-history" data-stripe-history hidden><h3>Purchase history</h3><ul data-stripe-purchases></ul></div>
  </section>
  <p class="pp-form-help" data-stripe-unavailable hidden>Buying credits is not available for this project yet. <a href="/contact" class="pp-text-link">Contact FetchX</a></p>
</>}
{view === 'overview' && <section class="pp-card"><div class="pp-card-heading"><div><h2>Recent requests</h2><p>The last requests made in this project.</p></div><a href="/app/requests" class="pp-text-link">View all <Icon name="arrow" size={16}/></a></div><div data-request-list data-request-limit="5"></div></section>}
{view === 'playground' && <div class="pp-playground-grid">
  <section class="pp-card pp-request-panel" aria-label="Request"><form data-playground-form autocomplete="off">
    <fieldset class="pp-request-config" aria-label="Request settings">
      <label class="pp-field">URL<input type="url" name="url" placeholder="https://example.com/" required maxlength="12000" spellcheck="false" autocomplete="off" aria-describedby="request-url-help"/><small id="request-url-help">Any public http or https URL.</small></label>
      <label class="pp-field">Browser<select name="render" aria-describedby="request-render-help">
        <option value="auto" selected>Auto: HTTP first, a browser when needed</option>
        <option value="always">Always use a browser</option>
        <option value="never">Never use a browser</option>
      </select><small id="request-render-help">Auto is the cheapest way to get the data.</small></label>
      <fieldset class="pp-scopes"><legend>Return</legend>{FORMATS.map(format => <label><input type="checkbox" name="formats" value={format} checked={format === 'markdown'}/>{format}</label>)}</fieldset>
      <details class="pp-request-advanced">
        <summary>Advanced</summary>
        <label class="pp-field">Country<input name="country" maxlength="2" placeholder="Learned per site, else US" pattern="[A-Za-z]{2}" spellcheck="false" autocomplete="off"/></label>
        <label class="pp-field">Route<select name="route">
          <option value="" selected>Auto: try every route</option>
          <option value="direct">Direct only</option>
          <option value="datacenter">Datacenter only</option>
          <option value="residential">Residential only</option>
        </select><small>A fixed route makes one attempt and explains exactly what happened.</small></label>
        <label class="pp-field">Wait for a CSS selector<input name="wait_selector" maxlength="512" placeholder=".price" spellcheck="false" autocomplete="off"/></label>
        <label class="pp-field">Most credits to spend<input type="number" name="max_credits" min="1" max="100000" step="1" inputmode="numeric" placeholder="No limit"/></label>
        <label class="pp-field">Most attempts<input type="number" name="max_attempts" min="1" max="5" step="1" inputmode="numeric" placeholder="5"/></label>
        <label class="pp-browser-option"><input type="checkbox" name="fix_headers" checked/> Fix automation headers (User-Agent, Accept)</label>
      </details>
    </fieldset>
    <div class="pp-request-send">
      <p class="pp-inline-error" data-fetch-error role="alert" hidden></p>
      <button type="submit" class="pp-button pp-button-primary pp-full" data-run-request disabled>Fetch <Icon name="arrow" size={17}/></button>
    </div>
  </form></section>
  <section class="pp-card pp-response-panel" aria-label="Result">
    <div class="pp-result-overview">
      <div class="pp-result-title"><h2>Result</h2><span class="pp-status" data-response-state role="status" aria-live="polite">Ready</span></div>
      <p class="pp-form-help" data-response-note>No request has been sent.</p>
      <dl class="pp-result-facts" data-result-facts hidden>
        <div><dt>Site status</dt><dd data-result-status>—</dd></div>
        <div><dt>Credits charged</dt><dd data-result-credits>—</dd></div>
        <div><dt>Attempts</dt><dd data-result-attempts>—</dd></div>
        <div><dt>Browser</dt><dd data-result-rendered>—</dd></div>
      </dl>
      <div data-attempt-list></div>
    </div>
    <div class="pp-response-toolbar"><div class="pp-tabs" role="tablist" aria-label="Result views">
      <button type="button" role="tab" id="tab-output" aria-selected="true" aria-controls="panel-output" data-inspector-tab="output">Content</button>
      <button type="button" role="tab" id="tab-headers" aria-selected="false" aria-controls="panel-headers" tabindex="-1" data-inspector-tab="headers">Headers</button>
      <button type="button" role="tab" id="tab-json" aria-selected="false" aria-controls="panel-json" tabindex="-1" data-inspector-tab="json">JSON</button>
      <button type="button" role="tab" id="tab-screenshot" aria-selected="false" aria-controls="panel-screenshot" tabindex="-1" data-inspector-tab="screenshot" hidden>Screenshot</button>
      <button type="button" role="tab" id="tab-code" aria-selected="false" aria-controls="panel-code" tabindex="-1" data-inspector-tab="code">Code</button>
    </div></div>
    <div class="pp-response-body" id="panel-output" role="tabpanel" aria-labelledby="tab-output" data-inspector-panel="output">
      <div class="pp-artifact-toolbar"><p class="pp-form-help" data-output-label>Content</p><button type="button" class="pp-copy-button" data-copy-output hidden>Copy</button><button type="button" class="pp-copy-button" data-download-body hidden>Download body</button></div>
      <pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Content" data-response-output>Fetch a URL to see its content.</pre>
    </div>
    <div class="pp-response-body" id="panel-headers" role="tabpanel" aria-labelledby="tab-headers" data-inspector-panel="headers" hidden>
      <pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Response headers and cookies" data-response-headers>No headers yet.</pre>
    </div>
    <div class="pp-response-body" id="panel-json" role="tabpanel" aria-labelledby="tab-json" data-inspector-panel="json" hidden>
      <pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="The API response" data-response-json>No response yet.</pre>
    </div>
    <div class="pp-response-body" id="panel-screenshot" role="tabpanel" aria-labelledby="tab-screenshot" data-inspector-panel="screenshot" hidden>
      <img class="pp-browser-screenshot" data-browser-screenshot alt="Screenshot of the fetched page"/>
    </div>
    <div class="pp-response-body" id="panel-code" role="tabpanel" aria-labelledby="tab-code" data-inspector-panel="code" hidden>
      <div class="pp-code-toolbar">
        <label>Language<select data-code-language><option value="curl">cURL</option><option value="javascript">JavaScript</option><option value="python">Python</option></select></label>
        <button type="button" class="pp-copy-button" data-copy-code>Copy code</button>
      </div>
      <pre class="pp-code pp-live-output" tabindex="0" role="region" aria-label="Request code" data-generated-code>Enter a URL to see the code for this request.</pre>
      <p class="pp-form-help">Set FETCHX_API_KEY in your server environment. Never put a key in browser code.</p>
    </div>
  </section>
</div>}
{view === 'requests' && <section class="pp-card"><div class="pp-card-heading"><div><h2>Requests</h2><p>Open a request to see its result and every attempt.</p></div><button type="button" class="pp-button pp-button-secondary" data-refresh-history>Refresh</button></div><div class="pp-filter-row"><label class="pp-field">Status<select data-request-filter><option value="">All</option><option value="succeeded">Succeeded</option><option value="failed">Failed</option><option value="pending">Pending</option></select></label><label class="pp-field pp-live-search">Tag<input type="search" data-request-tag maxlength="64" placeholder="Filter by tag"/></label><span class="pp-soft-tag" data-filter-count>Loading…</span></div><div data-request-list></div><button type="button" class="pp-button pp-button-secondary" data-more-requests hidden>Load more</button></section>}
{view === 'keys' && <>
  <div class="pp-callout"><Icon name="lock" size={22}/><div><strong>Project keys with explicit permissions.</strong><p>A secret is shown once. Rotating revokes the old key. Never put a key in browser code.</p></div></div>
  <section class="pp-card pp-live-key-create"><div class="pp-card-heading"><h2>Create an API key</h2></div><form data-create-key><label class="pp-field">Key name<input name="name" data-key-name maxlength="80" placeholder="Production server" required autocomplete="off"/></label><fieldset class="pp-scopes"><legend>Permissions</legend>{KEY_SCOPES.map(scope => <label><input type="checkbox" name="scope" value={scope.id} checked/>{scope.label} <small>{scope.detail}</small></label>)}</fieldset><button type="submit" class="pp-button pp-button-primary" data-generate-key>Create API key</button></form></section>
  <section class="pp-card"><div class="pp-card-heading"><div><h2>Project keys</h2><p>Existing secrets cannot be shown again.</p></div></div><div data-key-list></div></section>
  <section class="pp-card"><div class="pp-card-heading"><div><h2>Webhook signing secret</h2><p>Every webhook delivery is signed with this secret. Check <code>X-FetchX-Signature</code> with it.</p></div></div><div class="pp-key-row"><code class="pp-key-secret" data-webhook-secret-value>Concealed</code><div class="pp-key-actions"><button type="button" class="pp-button pp-button-secondary" data-webhook-secret-show>Show</button><button type="button" class="pp-button pp-button-secondary" data-webhook-secret-rotate>Rotate</button></div></div></section>
</>}
{view === 'onboarding' && <div class="pp-onboarding-layout"><section class="pp-card pp-checklist"><div class="pp-card-heading"><h2>Your first integration</h2><span class="pp-soft-tag" data-onboarding-count>Checking…</span></div><ol><li data-checklist-email><span class="pp-step-check">1</span><div><h3>Verify your email</h3><p>Your session belongs to a verified account.</p></div></li><li data-checklist-project><span class="pp-step-check">2</span><div><h3>Create a project</h3><p>Your first project gets the trial credits.</p><button type="button" class="pp-text-link" data-open-project>Create another project →</button></div></li><li data-checklist-key><span class="pp-step-check">3</span><div><h3>Create an API key</h3><p>Keep the secret in your server environment.</p><a href="/app/keys" class="pp-text-link">Manage API keys →</a></div></li><li data-checklist-request><span class="pp-step-check">4</span><div><h3>Fetch your first page</h3><p>Try a URL in the playground, then copy its code.</p><a href="/app/playground" class="pp-text-link">Open playground →</a></div></li></ol></section><aside class="pp-card pp-onboarding-aside"><span class="pp-eyebrow">ONLY SUCCESS IS CHARGED</span><h2>Retries are safe.</h2><p>Send an idempotency_key with each request. If a response is lost, send the same request again: FetchX returns the first result and never charges twice.</p><a href="/docs" class="pp-text-link">Read the API guide <Icon name="arrow" size={15}/></a></aside></div>}
