---
import Icon from './Icon.astro';
import { creditPackages } from '../data/credit-packages';
import '../styles/marketing.css';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['mkt-pricing', { 'mkt-pricing-compact': compact }]} data-local-pricing aria-busy="true">
  <div class="mkt-proposal-note"><span class="mkt-dot"></span><span>PREPAID CREDITS</span><p>One-time payments. No automatic renewal or scheduled expiration.</p></div>
  <p class="mkt-pricing-note" data-pricing-status role="status">Loading local pricing…</p>
  <div class="mkt-pricing-grid">
    <article class="mkt-plan mkt-plan-trial">
      <div class="mkt-plan-top"><h3>Free trial</h3></div>
      <div class="mkt-plan-price"><strong data-pricing-trial>Free</strong></div>
      <div class="mkt-plan-credits"><strong>1,000 trial credits</strong><span>One-time per eligible account</span></div>
      <a class="mkt-button mkt-button-secondary" href="/signup">Start free <Icon name="arrow" size={15}/></a>
    </article>
    {creditPackages.map(pack => <article class:list={['mkt-plan', { 'mkt-plan-featured': pack.credits === 1_000_000 }]} data-pricing-credits={pack.credits}>
      <div class="mkt-plan-top"><h3>{pack.name}</h3></div>
      <div class="mkt-plan-price"><strong data-pricing-amount>—</strong></div>
      <div class="mkt-plan-credits"><strong data-pricing-rate>Local price loads here</strong><span data-pricing-saving>Volume pricing</span></div>
      <a class:list={['mkt-button', pack.credits === 1_000_000 ? 'mkt-button-primary' : 'mkt-button-secondary']} href="/signup" data-pricing-link aria-label={`Review package for ${pack.name}`}>Review package <Icon name="arrow" size={15}/></a>
    </article>)}
  </div>
  <p class="mkt-pricing-note"><span data-pricing-note>Sign in to see prices and checkout availability for your location.</span> Trial credits apply to approved direct or datacenter routes. <a href="/pricing#credits">How credits work <Icon name="arrow" size={12}/></a></p>
  <noscript><p class="mkt-pricing-note">Enable JavaScript to load local prices and continue to checkout.</p></noscript>
</div>
<script>import '../scripts/pricing';</script>
<style>
  .mkt-pricing[data-pricing-currency="inr"] .mkt-plan-price > strong {
    font-size: clamp(27px, 3.7vw, 52px);
    letter-spacing: -.055em;
  }
</style>
