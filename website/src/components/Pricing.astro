---
import Icon from './Icon.astro';
import { creditPackages, formatUsd, formatUsdPerThousand } from '../data/credit-packages';
import '../styles/marketing.css';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['mkt-pricing', { 'mkt-pricing-compact': compact }]}>
  <div class="mkt-proposal-note"><span class="mkt-dot"></span><span>PREPAID CREDITS</span><p>One-time payments. No automatic renewal or scheduled expiration.</p></div>
  <div class="mkt-pricing-grid">
    <article class="mkt-plan mkt-plan-trial">
      <div class="mkt-plan-top"><h3>Free trial</h3></div>
      <div class="mkt-plan-price"><strong>{formatUsd(0)}</strong></div>
      <div class="mkt-plan-credits"><strong>1,000 trial credits</strong><span>One-time per eligible account</span></div>
      <a class="mkt-button mkt-button-secondary" href="/signup">Start free <Icon name="arrow" size={15}/></a>
    </article>
    {creditPackages.map(pack => <article class:list={['mkt-plan', { 'mkt-plan-featured': pack.id === 'credits-1000000' }]}>
      <div class="mkt-plan-top"><h3>{pack.name}</h3></div>
      <div class="mkt-plan-price"><strong>{formatUsd(pack.amount_minor)}</strong></div>
      <div class="mkt-plan-credits"><strong>{formatUsdPerThousand(pack.amount_minor, pack.credits)}</strong><span>{pack.saving ? `${pack.saving} lower unit price` : 'Entry pack'}</span></div>
      <a class:list={['mkt-button', pack.id === 'credits-1000000' ? 'mkt-button-primary' : 'mkt-button-secondary']} href={`/signup?plan=${pack.id}`} aria-label={`Review package for ${pack.name}`}>Review package <Icon name="arrow" size={15}/></a>
    </article>)}
  </div>
  <p class="mkt-pricing-note">Prices in USD. Savings compare the price per 1,000 credits with the $2 pack. During trial access, trial credits apply to eligible routes. Sign in to see eligibility, limits, and checkout availability. <a href="/pricing#credits">How credits work <Icon name="arrow" size={12}/></a></p>
</div>
