---
import Icon from '../Icon.astro';
interface Props { id?: string; }
const { id = 'api-example' } = Astro.props;
const request = `{
  "url": "https://shop.example.com/p/42",
  "formats": ["markdown"]
}`;
const snippets = [
  { label: 'cURL', code: `curl "$FETCHX_URL/v1/fetch" \\
  -H "Authorization: Bearer $FETCHX_TOKEN" \\
  -H 'Content-Type: application/json' \\
  -d '${request}'` },
  { label: 'JavaScript', code: `import {FetchXClient} from './clients/javascript.mjs';

const fetchx = new FetchXClient({
  url: process.env.FETCHX_URL,
  token: process.env.FETCHX_TOKEN,
});
const result = await fetchx.fetch(${request.replaceAll('\n', '\n  ')});
console.log(result.status, result.data?.markdown);` },
  { label: 'Python', code: `import os
from clients.python import FetchXClient

fetchx = FetchXClient(os.environ["FETCHX_URL"], os.environ["FETCHX_TOKEN"])
result = fetchx.fetch(url="https://shop.example.com/p/42", formats=["markdown"])
print(result["status"], result["data"]["markdown"])` },
];
const views = [
  {label:'Result', code:`{
  "status": "succeeded",
  "data": {
    "status_code": 200,
    "rendered": true,
    "markdown": "# Product 42\\n\\nIn stock."
  },
  "credits": { "charged": 25 }
}`, caption:'Only a successful request is charged, at the price of the step that got the data.'},
  {label:'Attempts', code:`"attempts": [
  { "transport": "http", "class": "direct",
    "result": "blocked", "status_code": 403 },
  { "transport": "browser", "class": "residential",
    "country": "US", "result": "success",
    "status_code": 200, "captcha": ["turnstile:passed"] }
]`, caption:'Every route tried, in order. Next time this site starts at the step that worked.'},
  {label:'Failure', code:`{
  "status": "failed",
  "credits": { "charged": 0 },
  "error": {
    "code": "rate_limited",
    "next": { "action": "retry_after",
      "retry_after_seconds": 120 }
  }
}`,caption:'A failure costs nothing and says what to do next.'},
];
---
<div class="mkt-api-demo">
  <section class="mkt-request-panel" aria-label="API request example" data-mkt-tabs>
    <div class="mkt-code-title"><span><span class="mkt-method">POST</span><code>/v1/fetch</code></span><button type="button" class="mkt-copy" data-mkt-copy aria-label="Copy selected request example"><Icon name="copy" size={14}/><span data-mkt-copy-label>Copy</span></button></div>
    <div class="mkt-code-tabs" role="tablist" aria-label="Request language">{snippets.map((snippet, i)=><button type="button" role="tab" id={`${id}-request-tab-${i}`} aria-controls={`${id}-request-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-mkt-tab>{snippet.label}</button>)}</div>
    {snippets.map((snippet,i)=><div id={`${id}-request-panel-${i}`} role="tabpanel" aria-labelledby={`${id}-request-tab-${i}`} tabindex="0" hidden={i!==0} data-mkt-panel><pre class="mkt-code"><code>{snippet.code}</code></pre></div>)}
    <div class="mkt-code-bottom"><span class="mkt-dot"></span> YOUR API KEY<span class="mkt-code-file">only url is required</span></div>
    <span class="mkt-sr-only" role="status" aria-live="polite" data-mkt-copy-status></span>
  </section>
  <section class="mkt-response-panel" aria-label="Illustrative API response" data-mkt-tabs>
    <div class="mkt-response-title"><span>INSPECT THE RESPONSE</span><span class="mkt-output-status"><Icon name="check" size={12}/> 200</span></div>
    <div class="mkt-code-tabs" role="tablist" aria-label="Response view">{views.map((view,i)=><button type="button" role="tab" id={`${id}-response-tab-${i}`} aria-controls={`${id}-response-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-mkt-tab>{view.label}</button>)}</div>
    {views.map((view,i)=><div id={`${id}-response-panel-${i}`} role="tabpanel" aria-labelledby={`${id}-response-tab-${i}`} tabindex="0" hidden={i!==0} data-mkt-panel><pre class="mkt-code"><code>{view.code}</code></pre><p class="mkt-response-caption">{view.caption}</p></div>)}
    <span class="mkt-response-label">SYNTHETIC RESPONSE EXCERPT</span>
  </section>
</div>
<p class="mkt-example-note">Set <code>FETCHX_URL</code> to <code>https://app.fetchx.ai</code> and <code>FETCHX_TOKEN</code> to your API key. <a href="/docs">Complete quickstart <Icon name="arrow" size={13}/></a></p>
