---
import Icon from '../Icon.astro';
import Brand from '../Brand.astro';
import MotionControl from '../MotionControl.astro';
---
<figure class="mkt-pipeline" aria-labelledby="pipeline-caption">
  <div class="mkt-pipeline-grid" aria-hidden="true"></div>
  <div class="mkt-pipeline-header"><span class="mkt-dot"></span><span>SAMPLE EXECUTION</span><span class="mkt-pipeline-id">FX / 001</span></div>
  <div class="mkt-pipeline-input"><span class="mkt-micro">01 / YOUR REQUEST</span><div><span class="mkt-method">POST</span><code>/v1/fetch</code><Icon name="arrow" size={17}/></div><span class="mkt-pipeline-url">https://source.example/data</span></div>
  <div class="mkt-pipeline-connector" aria-hidden="true"><span></span></div>
  <div class="mkt-pipeline-core"><div class="mkt-core-mark"><Brand compact/></div><div><strong>FetchX access engine</strong><span>Auto mode · cheapest route first</span></div><span class="mkt-core-light" aria-hidden="true"></span></div>
  <div class="mkt-pipeline-routes"><div><span class="mkt-route-dot"></span><span>ROUTE</span><b>residential</b></div><div><span class="mkt-route-dot"></span><span>FETCH</span><b>browser</b></div><div><span class="mkt-route-dot"></span><span>RETURN</span><b>markdown</b></div></div>
  <div class="mkt-pipeline-connector mkt-connector-bottom" aria-hidden="true"><span></span></div>
  <div class="mkt-pipeline-output"><div class="mkt-output-heading"><span class="mkt-micro">02 / RESPONSE</span><span class="mkt-output-status"><Icon name="check" size={12}/> succeeded</span></div><div class="mkt-output-code"><span><i>"status_code"</i>: <b>200</b>,</span><span><i>"markdown"</i>: <em>"# Data…"</em>,</span><span><i>"credits"</i>:</span><span class="mkt-code-indent"><em>{"{"} "charged": 25 {"}"}</em></span></div><div class="mkt-output-footer"><Icon name="lock" size={12}/><span>Charged only on success.</span><span class="mkt-dot"></span></div></div>
  <figcaption id="pipeline-caption">A synthetic request, from URL to markdown.</figcaption>
  <div class="mkt-pipeline-motion"><MotionControl/></div>
</figure>
