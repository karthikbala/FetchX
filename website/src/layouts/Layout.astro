---
import { CONTACT_EMAIL } from '../lib/contact';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import '../styles/redesign.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import MotionControl from '../components/MotionControl.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  appMode?: boolean;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  article?: { headline: string; datePublished: string; dateModified?: string };
}
const descriptions: Record<string, string> = {
  '/': 'FetchX brings web scraping, proxy routing and browser workflows into one API for developers, data teams and AI applications. Explore the product preview.',
  '/samples': 'Explore fictional commerce, property and logistics records showing how source data can be used in applications. View JSON or download sample CSV files.',
  '/pricing': 'Explore proposed FetchX API credit plans, from a free trial to developer and enterprise plans. Understand usage, limits and the commercial preview.',
  '/pilot': 'Discuss source access, integration requirements and a technical evaluation with the FetchX team.',
  '/developers': 'Build with FetchX native HTTP and reviewed browser workflows. Explore API examples, recovery guidance, project access and the interactive product preview.',
  '/privacy': 'How FetchX handles website enquiries, security information, service providers and data retention.',
  '/terms': 'FetchX website terms for source qualification, illustrative samples, enquiries and workspace access.',
};
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const {
  title = 'FetchX — Web Scraping API & Web Unblocker',
  description = descriptions[path] || descriptions['/'],
  active = '', appMode = false, noindex = false, breadcrumbs = [], article,
} = Astro.props;
const launchReady = import.meta.env.PUBLIC_SITE_ENV === 'production' && import.meta.env.PUBLIC_PRODUCT_LAUNCH_READY === 'true';
const privatePage = appMode || path === '/signup' || path === '/login' || path === '/app' || path.startsWith('/app/');
const indexable = launchReady && !privatePage && !noindex && path !== '/404';
const canonical = new URL(path, 'https://fetchx.ai').href;
const organization = { '@type': 'Organization', '@id': 'https://fetchx.ai/#organization', name: 'FetchX', url: 'https://fetchx.ai', logo: 'https://fetchx.ai/brand/icon.svg' };
const graph: Record<string, unknown>[] = [organization, { '@type': 'WebSite', '@id': 'https://fetchx.ai/#website', url: 'https://fetchx.ai', name: 'FetchX', publisher: { '@id': 'https://fetchx.ai/#organization' } }];
if (breadcrumbs.length) graph.push({ '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.path, 'https://fetchx.ai').href })) });
if (article) graph.push({ '@type': 'Article', headline: article.headline, datePublished: article.datePublished, dateModified: article.dateModified || article.datePublished, mainEntityOfPage: canonical, author: { '@type': 'Organization', name: 'FetchX engineering', url: 'https://fetchx.ai/about' }, publisher: { '@id': 'https://fetchx.ai/#organization' }, image: 'https://fetchx.ai/brand/social.png' });
if (path === '/products/web-scraping-api') graph.push({ '@type': 'SoftwareApplication', name: 'FetchX Web Scraping API', applicationCategory: 'DeveloperApplication', operatingSystem: 'Web', url: canonical, description, publisher: { '@id': 'https://fetchx.ai/#organization' } });
const schema = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const productLinks = [['Web Scraping API', '/products/web-scraping-api'], ['Web Unblocker', '/products/web-unblocker'], ['JavaScript Rendering', '/products/javascript-rendering'], ['Proxy Management', '/products/proxy-management']];
const useCaseLinks = [['AI agents & RAG', '/use-cases/ai-agents'], ['Price monitoring', '/use-cases/price-monitoring'], ['Real estate data', '/use-cases/real-estate']];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'}/>
    <meta name="description" content={description}/><meta name="theme-color" content="#080D12"/>
    <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/brand/icon.svg"/>
    <meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:site_name" content="FetchX"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content="https://fetchx.ai/brand/social.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="FetchX — Unlock the web. With one API."/><meta name="twitter:card" content="summary_large_image"/>
    <title>{title}</title>
    {!privatePage && <script type="application/ld+json" set:html={schema}/>}
  </head>
  <body class:list={{ 'app-mode': appMode }}>
    <a href="#main" class="skip-link">Skip to content</a>
    {!appMode && <>
      {!launchReady && <div class="review-banner"><span class="review-dot"></span> Product design preview <span class="review-divider">/</span><span>Sample activity · Proposed pricing</span><a href="/app">Explore the workspace <span aria-hidden="true">↗</span></a></div>}
      <header class="fx-header">
        <div class="fx-nav-shell">
          <a class="logo-link" href="/" aria-label="FetchX home"><Brand/></a>
          <nav id="navigation" class="fx-nav" aria-label="Main navigation">
            <details class="fx-nav-group"><summary>Product <Icon name="chevron" size={12}/></summary><div class="fx-nav-popover">{productLinks.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}<Icon name="arrow" size={14}/></a>)}</div></details>
            <details class="fx-nav-group"><summary>Use cases <Icon name="chevron" size={12}/></summary><div class="fx-nav-popover">{useCaseLinks.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}<Icon name="arrow" size={14}/></a>)}</div></details>
            <a href="/developers" aria-current={active === 'developers' ? 'page' : undefined}>Developers</a>
            <a href="/pricing" aria-current={active === 'pricing' ? 'page' : undefined}>Pricing</a>
            <a href="/resources" aria-current={active === 'resources' ? 'page' : undefined}>Resources</a>
            <a class="fx-mobile-docs" href="/docs">API docs</a>
            <a class="fx-mobile-signin" href="/login">Sign in</a>
          </nav>
          <div class="fx-nav-actions"><a class="fx-signin" href="/login">Sign in</a><a class="button button-small button-ink" href="/signup">Start building <Icon name="diagonal" size={15}/></a></div>
          <button class="mobile-menu icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button>
        </div>
      </header>
    </>}
    <main id="main"><slot/></main>
    {!appMode && <footer class="fx-footer">
      <div class="fx-footer-grid container">
        <div class="fx-footer-brand"><a href="/" class="logo-link" aria-label="FetchX home"><Brand/></a><p>Web access.<br/>Engineered for what’s next.</p><MotionControl/></div>
        <div class="fx-footer-column"><h2>Product</h2>{productLinks.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/pricing">Pricing</a><a href="/app">Workspace preview</a></div>
        <div class="fx-footer-column"><h2>Build</h2><a href="/docs">API documentation</a><a href="/developers">Developer overview</a><a href="/resources">Guides & resources</a><a href="/llms.txt">For AI readers</a></div>
        <div class="fx-footer-column"><h2>Company</h2><a href="/about">About FetchX</a><a href="/contact">Contact us</a><a href="/privacy">Privacy</a><a href="/terms">Website terms</a><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></div>
      </div>
      <div class="fx-footer-bottom container"><span>© {new Date().getUTCFullYear()} FetchX</span><span class="mono">PUBLIC WEB. REAL POSSIBILITIES.<span class="tiny-dot"></span></span></div>
    </footer>}
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
