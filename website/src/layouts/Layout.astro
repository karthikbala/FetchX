---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import MotionControl from '../components/MotionControl.astro';
const descriptions: Record<string,string> = {
 '/':'Tell us the websites, fields and update schedule. FetchX manages collection, checks and structured data delivery. Paid pilots start at $99.',
 '/samples':'Explore fictional commerce, property and logistics datasets. Switch between tables and JSON, and download matching CSV samples without signing up.',
 '/pricing':'Start with a $99 data pilot. Explore FetchX managed web data plans, published record allowances, source qualification and delivery inclusions.',
 '/pilot':'Request a scoped FetchX data pilot. Share your target websites, required fields, refresh schedule and delivery preferences.',
 '/developers':'Scope FetchX API access and delivery integrations for qualified workflows. Explore the open-source gateway and technical onboarding.',
 '/privacy':'How Headrun Technologies Private Limited handles FetchX website enquiries, security information, service providers and data retention.',
 '/terms':'Website terms for FetchX, operated by Headrun Technologies Private Limited. Source qualification, illustrative samples and enquiry terms.'
};
const path=Astro.url.pathname.replace(/\/$/,'').replace(/\.html$/,'').replace(/\/index$/,'') || '/';
const {title='FetchX — The web data your business needs. Delivered.',description=descriptions[path]||descriptions['/'],active=''}=Astro.props;
const production=import.meta.env.PUBLIC_SITE_ENV==='production';
const canonical=new URL(path,'https://fetchx.ai').href;
---
<!doctype html>
<html lang="en" data-theme="dark">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content={production&&path!=='/404'?'index,follow':'noindex,nofollow'}/><meta name="description" content={description}/><meta name="theme-color" content="#111b16"/>
  <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/brand/icon.svg"/>
  <meta property="og:type" content="website"/><meta property="og:site_name" content="FetchX"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://fetchx.ai/brand/social.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="FetchX — The web data your business needs. Delivered."/><meta name="twitter:card" content="summary_large_image"/><title>{title}</title>
 </head>
 <body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><div class="container nav-row"><a class="logo-link" href="/" aria-label="FetchX home"><Brand/></a><nav id="navigation" aria-label="Main navigation"><a href="/#solutions">Solutions</a><a href="/#how-it-works">How it works</a><a href="/samples" aria-current={active==='samples'?'page':undefined}>Sample data</a><a href="/pricing" aria-current={active==='pricing'?'page':undefined}>Pricing</a></nav><a class="button button-small button-ink nav-cta" href="/pilot">Request a pilot <Icon name="diagonal" size={16}/></a><button class="mobile-menu icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button></div></header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><div class="container footer-top"><div><a href="/" class="logo-link" aria-label="FetchX home"><Brand/></a><p>From the web.<br/>Into your workflow.</p><MotionControl/></div><div class="footer-links"><a href="/samples">Sample data</a><a href="/pricing">Pricing</a><a href="/developers">For developers</a><a href="https://github.com/karthikbala/FetchX" target="_blank" rel="noreferrer">View source <Icon name="diagonal" size={13}/></a><a href="/privacy">Privacy</a><a href="/terms">Website terms</a></div><div class="footer-note"><span class="eyebrow">A BETTER WAY TO GET WEB DATA</span><p>You bring the question.<br/>We help you get the data.</p><a class="text-link" href="/pilot">Let’s scope your first dataset <Icon name="arrow" size={17}/></a><a class="footer-email" href="mailto:sales@headrun.ai">sales@headrun.ai</a></div></div><div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} FetchX. Operated by Headrun Technologies Private Limited.</span>{!production&&<span>Preview · Launch setup in progress.</span>}<span class="mono">fetchx.ai <span class="tiny-dot"></span></span></div></footer>
  <script>import '../scripts/site.ts';</script>
 </body>
</html>
