{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*.astro", "src/scripts/**/*.ts", "src/lib/**/*.ts", "src/data/**/*.ts", "src/pages/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    ".local"
  ],
  "compilerOptions": {
    "types": ["astro/client"],
    "skipLibCheck": true
  }
}
