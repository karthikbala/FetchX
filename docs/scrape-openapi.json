{
  "openapi": "3.1.0",
  "info": {"title": "FetchX Scrape API", "version": "2"},
  "paths": {
    "/v2/scrape": {
      "post": {
        "operationId": "scrape",
        "summary": "Render one page and convert its retained DOM",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "description": "Replay with this key to recover the original capture. The gateway generates a key when omitted.",
            "schema": {"$ref": "#/components/schemas/IdempotencyKey"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScrapeRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Rendered page and requested formats",
            "headers": {"X-Idempotency-Key": {"required": true, "schema": {"$ref": "#/components/schemas/IdempotencyKey"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScrapeSuccess"}}}
          },
          "default": {
            "description": "Request rejected, source failure, or operation outcome unavailable",
            "headers": {"X-Idempotency-Key": {"schema": {"$ref": "#/components/schemas/IdempotencyKey"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScrapeFailure"}}}
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "IdempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
      "ScrapeFormat": {"type": "string", "enum": ["markdown", "html", "rawHtml", "links"]},
      "ScrapeRequest": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "format": "uri", "maxLength": 12000, "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"},
          "formats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "default": ["markdown"],
            "items": {
              "oneOf": [
                {"$ref": "#/components/schemas/ScrapeFormat"},
                {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": {"type": {"$ref": "#/components/schemas/ScrapeFormat"}}
                }
              ]
            }
          },
          "onlyMainContent": {"type": "boolean", "default": true},
          "waitFor": {
            "type": "integer", "minimum": 0, "maximum": 2000, "default": 0,
            "description": "Additional settle time in milliseconds, subject to the access profile limit."
          },
          "timeout": {
            "type": "integer", "minimum": 1000, "maximum": 300000,
            "description": "Requested browser operation deadline in milliseconds, capped by the access profile and existing dispatch limits."
          },
          "origin": {"type": "string", "maxLength": 256, "description": "Discarded SDK attribution."},
          "integration": {"type": "string", "maxLength": 256, "description": "Discarded SDK attribution."},
          "mobile": {"type": "boolean", "const": false, "description": "Discarded Python SDK default."},
          "removeBase64Images": {"type": "boolean", "const": true, "description": "Discarded Python SDK default."},
          "fastMode": {"type": "boolean", "const": false, "description": "Discarded Python SDK default."},
          "blockAds": {"type": "boolean", "const": true, "description": "Discarded Python SDK default."},
          "maxAge": {"type": "integer", "const": 14400000, "description": "Discarded Python SDK default."},
          "storeInCache": {"type": "boolean", "const": true, "description": "Discarded Python SDK default."}
        }
      },
      "ScrapeMetadata": {
        "type": "object",
        "required": ["sourceURL", "url", "statusCode"],
        "additionalProperties": false,
        "properties": {
          "sourceURL": {"type": "string", "format": "uri"},
          "url": {"type": "string", "format": "uri"},
          "statusCode": {"type": "integer"},
          "contentType": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "language": {"type": "string"}
        }
      },
      "ScrapeDocument": {
        "type": "object",
        "required": ["metadata"],
        "additionalProperties": false,
        "properties": {
          "metadata": {"$ref": "#/components/schemas/ScrapeMetadata"},
          "markdown": {"type": "string"},
          "html": {"type": "string"},
          "rawHtml": {"type": "string"},
          "links": {"type": "array", "maxItems": 1024, "items": {"type": "string", "format": "uri"}}
        }
      },
      "ScrapeSuccess": {
        "type": "object",
        "required": ["success", "data"],
        "additionalProperties": false,
        "properties": {"success": {"type": "boolean", "const": true}, "data": {"$ref": "#/components/schemas/ScrapeDocument"}}
      },
      "ScrapeFailure": {
        "type": "object",
        "required": ["success", "code", "error"],
        "additionalProperties": false,
        "properties": {
          "success": {"type": "boolean", "const": false},
          "code": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    }
  }
}
