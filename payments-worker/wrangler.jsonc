{
  "name": "fetchx-stripe-broker",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "ratelimits": [
    { "name": "BROKER_RATE_LIMIT", "namespace_id": "62341001", "simple": { "limit": 120, "period": 60 } },
    { "name": "BROKER_WRITE_RATE_LIMIT", "namespace_id": "62341002", "simple": { "limit": 20, "period": 60 } }
  ]
}
