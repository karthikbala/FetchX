{
  "name": "fetchx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "api:generate": "openapi-typescript docs/openapi.json --output clients/openapi.d.ts --default-non-nullable false",
    "api:check": "npm run api:generate -- --check",
    "test:types": "tsc -p clients/tsconfig.test.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "ipaddr.js": "2.2.0",
    "jose": "6.2.15",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
