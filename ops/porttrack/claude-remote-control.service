# Installed on porttrack as /etc/systemd/system/claude-remote-control.service (root:root 644).
# Keeps Claude Code Remote Control running for the ops user, and brings it back after a crash or reboot.
# A dedicated tmux socket (-L claude-rc) gives it a terminal without sharing a server with other tmux sessions;
# attach with: sudo -u ops tmux -L claude-rc attach -t claude-rc
[Unit]
Description=Claude Code Remote Control for porttrack-production (FetchX ops)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=forking
User=ops
Group=ops
WorkingDirectory=/opt/crawling-platform
Environment=HOME=/home/ops
Environment=TERM=xterm-256color
Environment=PATH=/home/ops/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/tmux -L claude-rc new-session -d -s claude-rc '/home/ops/.local/bin/claude remote-control'
ExecStop=/usr/bin/tmux -L claude-rc kill-server
Restart=always
RestartSec=15
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
